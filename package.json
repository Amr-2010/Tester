{
  "name": "advertising-broadcast-suite",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "desktop": "electron .",
    "build:windows": "electron-builder --win nsis",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "check:syntax": "node --check server.js && node --check public/app.js && node --check desktop/main.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pdfkit": "^0.15.2",
    "exceljs": "^4.4.0",
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "@capacitor/ios": "^7.0.0"
  },
  "main": "desktop/main.js",
  "build": {
    "appId": "com.albayan.testingcenter",
    "productName": "AlBayan Testing Center",
    "files": [
      "desktop/**/*",
      "public/**/*",
      "package.json",
      "branding/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "branding/albayan.ico"
    }
  }
}
