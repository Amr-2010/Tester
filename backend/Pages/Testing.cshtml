:root{--blue:#075aab;--cyan:#09b7d5;--orange:#ff9819;--ink:#142b42;--muted:#60798d;--line:#dce8ed;--pale:#e4eff4}*{box-sizing:border-box}body{margin:0;font:15px system-ui,'Segoe UI',Tahoma,Arial;background:#f7fafc;color:var(--ink)}.top{background:linear-gradient(90deg,#0aaac9,#0871b8);color:#fff;padding:9px 4%;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;font-size:12px}.head{background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:30px;padding:14px 4%;position:sticky;top:0;z-index:5;box-shadow:0 3px 14px #17415c0c}.brand{display:flex;align-items:center;gap:12px;min-width:235px}.brand img{width:62px;height:62px;object-fit:contain}.brand strong{color:var(--blue);font-size:18px;display:block}.brand small{color:var(--muted)}nav{display:flex;align-items:center;gap:22px;flex:1}nav a{color:var(--ink);text-decoration:none;font-weight:650}nav a:hover{color:var(--blue)}button,.btn{background:var(--cyan);color:white;border:0;border-radius:6px;padding:12px 20px;font:inherit;font-weight:700;cursor:pointer}.outline{background:white;color:var(--blue);border:1px solid var(--line)}.layout{display:grid;grid-template-columns:265px 1fr;min-height:calc(100vh - 135px)}aside{background:#d8e6eb;padding:24px 20px;border-left:1px solid #cbdce4}aside h3{color:#079eb9;margin:0 0 22px}aside a{display:block;text-decoration:none;color:#142b42;padding:13px 10px;border-radius:7px;font-weight:650}aside a:hover,aside a.active{background:#fff;color:var(--blue)}main{padding:34px clamp(18px,4vw,60px);max-width:1450px;width:100%;margin:auto}.crumb{font-size:12px;color:#6e8290}.hero{display:flex;justify-content:space-between;align-items:center;gap:24px;margin:20px 0 30px}.hero h1{font-size:clamp(25px,3vw,38px);font-weight:550;margin:0 0 12px}.hero p{max-width:680px;color:var(--muted);line-height:1.9}.hero-mark{border:2px dashed #8ed9e6;color:var(--blue);font-size:54px;border-radius:50%;height:145px;min-width:145px;display:grid;place-items:center}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.card{background:white;border:1px solid var(--line);border-radius:12px;padding:23px;box-shadow:0 6px 20px #153d5d0a}.card h3{margin:8px 0 12px}.card p{color:var(--muted);line-height:1.8;min-height:65px}.glyph{font-size:28px}.panel{margin-top:24px;background:white;border:1px solid var(--line);padding:24px;border-radius:12px}.panel h2{margin-top:0;font-size:21px}.fields{display:grid;grid-template-columns:1fr 1fr auto;gap:12px;align-items:end}label{font-weight:650;font-size:13px;display:block;margin-bottom:7px}input,select{width:100%;padding:12px;border:1px solid #cbdce4;border-radius:6px;font:inherit}footer{text-align:center;border-top:1px solid var(--line);padding:24px;color:var(--muted);font-size:12px}#note{color:var(--blue);margin-top:14px} @media(max-width:1050px){nav{gap:12px;flex-wrap:wrap}.cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:750px){.head{flex-wrap:wrap}.layout{display:block}aside{display:flex;overflow-x:auto;gap:5px;padding:10px}aside h3{display:none}aside a{white-space:nowrap}.cards{grid-template-columns:1fr}.hero-mark{display:none}.fields{grid-template-columns:1fr}.top{font-size:11px}}
</style></head><body>
